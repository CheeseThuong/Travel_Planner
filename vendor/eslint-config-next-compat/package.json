{
  "name": "eslint-config-next",
  "version": "16.4.2+project.1",
  "description": "Project snapshot of Next lint config with explicit compatibility adapter dependencies; all config implementations unchanged",
  "license": "MIT",
  "repository": {
    "url": "vercel/next.js",
    "directory": "packages/eslint-config-next"
  },
  "homepage": "https://nextjs.org/docs/app/api-reference/config/eslint",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@next/eslint-plugin-next": "file:../eslint-plugin-next",
    "eslint-import-resolver-node": "^0.3.6",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "file:../eslint-plugin-import-compat",
    "eslint-plugin-jsx-a11y": "file:../eslint-plugin-jsx-a11y-compat",
    "eslint-plugin-react": "file:../eslint-plugin-react-compat",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "16.4.0",
    "typescript-eslint": "^8.56.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": ">=3.3.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core-web-vitals": {
      "types": "./dist/core-web-vitals.d.ts",
      "default": "./dist/core-web-vitals.js"
    },
    "./typescript": {
      "types": "./dist/typescript.d.ts",
      "default": "./dist/typescript.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    }
  },
  "private": true
