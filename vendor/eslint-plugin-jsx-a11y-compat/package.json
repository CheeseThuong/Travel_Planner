{
  "name": "eslint-plugin-jsx-a11y",
  "version": "6.10.2+project.1",
  "description": "Project-maintained ESLint10 compatibility adapter for eslint-plugin-jsx-a11y@6.10.2; not an upstream release",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "a11y",
    "accessibility",
    "jsx"
  ],
  "author": "Ethan Cohen",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsx-eslint/eslint-plugin-jsx-a11y"
  },
  "main": "project-compat.cjs",
  "engines": {
    "node": ">=4.0"
  },
  "license": "MIT",
  "dependencies": {
    "aria-query": "^5.3.2",
    "array-includes": "^3.1.8",
    "array.prototype.flatmap": "^1.3.2",
    "ast-types-flow": "^0.0.8",
    "axe-core": "^4.10.0",
    "axobject-query": "^4.1.0",
    "damerau-levenshtein": "^1.0.8",
    "emoji-regex": "^9.2.2",
    "hasown": "^2.0.2",
    "jsx-ast-utils": "^3.3.5",
    "language-tags": "^1.0.9",
    "minimatch": "^3.1.2",
    "object.fromentries": "^2.0.8",
    "safe-regex-test": "^1.0.3",
    "string.prototype.includes": "^2.0.1",
    "@eslint/compat": "2.1.1"
  },
  "peerDependencies": {
    "eslint": "^10.13.0"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
    "unreleased": false,
    "commitLimit": false,
    "backfillLimit": false,
    "hideCredit": true,
    "startingVersion": "6.6.2"
  },
  "publishConfig": {
    "ignore": [
      "!lib",
      ".github/workflows",
      ".flowconfig",
      "/src",
      "/reports",
      "/flow",
      "scripts/",
      "CONTRIBUTING.md",
      "/examples"
    ]
  },
  "private": true
}
