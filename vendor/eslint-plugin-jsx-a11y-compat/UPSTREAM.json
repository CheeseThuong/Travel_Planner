      "language-tags": "^1.0.9",
      "minimatch": "^3.1.2",
      "object.fromentries": "^2.0.8",
      "safe-regex-test": "^1.0.3",
      "string.prototype.includes": "^2.0.1"
    },
    "peerDependencies": {
      "eslint": "^3 || ^4 || ^5 || ^6 || ^7 || ^8 || ^9"
    },
    "auto-changelog": {
      "output": "CHANGELOG.md",
      "template": "keepachangelog",
      "unreleased": false,
      "commitLimit": false,
      "backfillLimit": false,
      "hideCredit": true,
      "startingVersion": "6.6.2"
    },
    "publishConfig": {
      "ignore": [
        "!lib",
        ".github/workflows",
        ".flowconfig",
        "/src",
        "/reports",
        "/flow",
        "scripts/",
        "CONTRIBUTING.md",
        "/examples"
      ]
    }
  },
