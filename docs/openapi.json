{
  "openapi": "3.1.0",
  "info": {
    "title": "Travel Planner implemented API",
    "version": "0.1.0",
    "description": "Implemented liveness and no-fetch editorial Maps resolution. Other Master endpoints remain unimplemented."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Application liveness only",
        "responses": {
          "200": {
            "description": "Liveness envelope without provider or database readiness claims",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "ok"
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/places/resolve": {
      "post": {
        "operationId": "resolvePlace",
        "summary": "Match a Maps URL hint against the independent destination catalog; no outbound fetch",
        "description": "Short/opaque links require manual entry or an expanded link. Candidates require user confirmation. Instance-local limit:60 requests/minute; not distributed production protection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "destination_slug"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "destination_slug": {
                    "enum": [
                      "nha-trang",
                      "da-lat"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirm independent candidates or use manual entry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "status",
                        "candidates",
                        "manual_entry_available"
                      ],
                      "properties": {
                        "status": {
                          "enum": [
                            "candidate_selection_required",
                            "manual_entry_required"
                          ]
                        },
                        "candidates": {
                          "type": "array",
                          "maxItems": 10,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "provider",
                              "editorial_place_id",
                              "display_name",
                              "location",
                              "confidence"
                            ],
                            "properties": {
                              "provider": {
                                "const": "editorial"
                              },
                              "editorial_place_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "display_name": {
                                "type": "string"
                              },
                              "location": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "lat",
                                  "lng"
                                ],
                                "properties": {
                                  "lat": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                  },
                                  "lng": {
                                    "type": "number",
                                    "minimum": -180,
                                    "maximum": 180
                                  }
                                }
                              },
                              "confidence": {
                                "const": "medium"
                              }
                            }
                          }
                        },
                        "manual_entry_available": {
                          "const": true
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON or unsupported URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "details"
                      ],
                      "properties": {
                        "code": {
                          "enum": [
                            "VALIDATION_ERROR",
                            "UNSUPPORTED_URL",
                            "UNSAFE_REDIRECT",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": false
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds8192 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "details"
                      ],
                      "properties": {
                        "code": {
                          "enum": [
                            "VALIDATION_ERROR",
                            "UNSUPPORTED_URL",
                            "UNSAFE_REDIRECT",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": false
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid schema",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "details"
                      ],
                      "properties": {
                        "code": {
                          "enum": [
                            "VALIDATION_ERROR",
                            "UNSUPPORTED_URL",
                            "UNSAFE_REDIRECT",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": false
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Instance quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "details"
                      ],
                      "properties": {
                        "code": {
                          "enum": [
                            "VALIDATION_ERROR",
                            "UNSUPPORTED_URL",
                            "UNSAFE_REDIRECT",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": false
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Generic internal error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "code",
                        "message",
                        "details"
                      ],
                      "properties": {
                        "code": {
                          "enum": [
                            "VALIDATION_ERROR",
                            "UNSUPPORTED_URL",
                            "UNSAFE_REDIRECT",
                            "RATE_LIMITED",
                            "INTERNAL_ERROR"
                          ]
                        },
                        "message": {
                          "type": "string"
                        },
                        "details": {
                          "type": "object",
                          "additionalProperties": false
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "request_id"
                      ],
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
