# P01-04 validates these server settings. Cloud/Google feature adapters are not implemented yet.
# Copying this file does not implement cloud save, Google routing or sharing.
# Use separate local/staging/production projects; never place real secrets here.
NEXT_TELEMETRY_DISABLED=1
DEPLOYMENT_ENV=local
CLOUD_ENABLED=false

# Optional Open-Meteo forecast. Free endpoint is for non-commercial use only.
# Enable after reviewing https://open-meteo.com/en/terms; CI uses fixtures.
DOC_WEATHER_ENABLED=false

# Future Supabase public project configuration (safe public key; RLS required).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC or expose in client code/logs.
SUPABASE_SERVICE_ROLE_KEY=

# Future server-side Google adapter, off until quota/policy/staging verification.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_LIVE_ENABLED=false
GOOGLE_MAPS_DAILY_BUDGET_MINOR=0
# Future browser map only: separate referrer/API-restricted public browser key.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Future server-side share HMAC and rate limiter configuration belong to P06.
# Exact variable contracts must be finalized/tested before use; no secrets here.

# Optional Brave discovery. OFF: no paid requests; independent catalog remains available.
# Enable only after provider-account spending limits, terms and deployment quotas are reviewed.
# No provider search-result cache or permanent Brave POI IDs.
BRAVE_ENABLED=false
BRAVE_API_KEY=
BRAVE_DAILY_REQUEST_LIMIT=0
BRAVE_MINUTE_REQUEST_LIMIT=10

# Optional server-only Groq ranking, OFF until account/model/cost/data controls are reviewed.
# Set an explicitly reviewed production strict-output model; no default model or live call.
# Prices are operator-supplied current USD per1M tokens, not hardcoded quotes.
# Micro-USD budget: 1 USD = 1000000 units. Reservations are conservative estimates;
# actual organization spend limits, ZDR and shared limits require staging/G8 review.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_COST_CONTROLS_APPROVED=false
GROQ_ZDR_CONFIRMED=false
GROQ_DAILY_REQUEST_LIMIT=0
GROQ_MINUTE_REQUEST_LIMIT=5
GROQ_DAILY_TOKEN_LIMIT=0
GROQ_DAILY_BUDGET_MICRO_USD=0
GROQ_INPUT_USD_PER_MILLION=0
GROQ_OUTPUT_USD_PER_MILLION=0
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TIMEOUT_MS=4000
