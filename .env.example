# P01-04 validates these server settings. Cloud/Google feature adapters are not implemented yet.
# Copying this file does not implement cloud save, Google routing or sharing.
# Use separate local/staging/production projects; never place real secrets here.
NEXT_TELEMETRY_DISABLED=1
DEPLOYMENT_ENV=local
CLOUD_ENABLED=false

# Future Supabase public project configuration (safe public key; RLS required).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC or expose in client code/logs.
SUPABASE_SERVICE_ROLE_KEY=

# Future server-side Google adapter, off until quota/policy/staging verification.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_LIVE_ENABLED=false
GOOGLE_MAPS_DAILY_BUDGET_MINOR=0
# Future browser map only: separate referrer/API-restricted public browser key.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Future server-side share HMAC and rate limiter configuration belong to P06.
# Exact variable contracts must be finalized/tested before use; no secrets here.
