{
  "name": "vietnam-playful-travel-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-production-types.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "node scripts/prepare-production-types.mjs && next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:content": "node scripts/verify-p00-01.mjs && node scripts/verify-p00-02.mjs && node scripts/verify-p00-03.mjs && node scripts/verify-p00-04.mjs && node scripts/verify-p00-05.mjs",
    "test:smoke": "node scripts/smoke-scaffold.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:unit": "npm run test:tooling && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/smoke-scaffold.mjs",
    "test:e2e": "playwright test --config playwright.demo.config.mjs",
    "test:typography": "playwright test --config playwright.typography.config.mjs",
    "db:seed:check": "node scripts/build-catalog-db-seed.mjs --check",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "test:db": "node scripts/supabase-local.mjs test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-utils": "4.9.1",
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-next": "file:./vendor/eslint-config-next-compat",
    "eslint-plugin-import": "file:./vendor/eslint-plugin-import-compat",
    "eslint-plugin-jsx-a11y": "file:./vendor/eslint-plugin-jsx-a11y-compat",
    "eslint-plugin-react": "file:./vendor/eslint-plugin-react-compat",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
